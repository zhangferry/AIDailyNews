---
import { SITE } from "$/config";
import { NAV_ITEMS } from "$/config";
import SvgIcon from "./SvgIcon.astro";
import ModeSwitcherBtn from "./ModeSwitcherBtn.svelte";
import SearchBtn from "./SearchBtn.svelte";
---

<header class="site-header">
  <div class="header-inner">
    <!-- Left: Brand -->
    <a href="/" class="brand">
      <span class="brand-name">Daily<span class="brand-accent">News</span><span class="brand-caption">每日科技简报</span></span>
    </a>

    <!-- Center: Navigation -->
    <nav class="header-nav" aria-label="主导航">
      {Object.keys(NAV_ITEMS).map((navItemKey, index) => (
        <>

          <a
            class:list={[
              "nav-link",
              (NAV_ITEMS[navItemKey].path === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(NAV_ITEMS[navItemKey].path)) ? "nav-link-active" : "",
            ]}
            href={NAV_ITEMS[navItemKey].path}
            aria-current={(NAV_ITEMS[navItemKey].path === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(NAV_ITEMS[navItemKey].path)) ? "page" : undefined}
          >
            {NAV_ITEMS[navItemKey].title}
          </a>
        </>
      ))}
    </nav>

    <!-- Right: Actions -->
    <div class="header-actions">
      <SearchBtn client:load />
      <a href={SITE.githubUrl} title="GitHub" class="action-btn" aria-label="GitHub">
        <SvgIcon>
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </SvgIcon>
      </a>
      <a href="/rss.xml" title="RSS" class="action-btn" aria-label="RSS">
        <SvgIcon>
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </SvgIcon>
      </a>
      <div class="action-btn">
        <ModeSwitcherBtn client:visible />
      </div>
    </div>
  </div>
</header>

<script>
  let headerObserver: ResizeObserver | undefined;
  function observeHeader() {
    headerObserver?.disconnect();
    const header = document.querySelector<HTMLElement>(".site-header");
    if (!header) return;
    const updateHeaderHeight = () => {
      document.documentElement.style.setProperty(
        "--header-height",
        `${header.getBoundingClientRect().height}px`,
      );
    };
    updateHeaderHeight();
    headerObserver = new ResizeObserver(updateHeaderHeight);
    headerObserver.observe(header);
  }
  observeHeader();
  document.addEventListener("astro:page-load", observeHeader);
</script>
