---
export const prerender = true;
import { getCollection } from "astro:content";
import DefaultPageLayout from "$/layouts/default.astro";
import Code from "$/components/Code.astro";
import DailyBrief from "$/components/DailyBrief.astro";
import PostPreviewList from "$/components/PostPreviewList.astro";
const posts = (await getCollection("blog")).toSorted((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestPost = posts[0];
const rendered = latestPost ? await latestPost.render() : undefined;
const Content = rendered?.Content;
---
<DefaultPageLayout content={{ title: "每日科技简报", description: "由 RSS 汇集、AI 辅助整理的每日科技新闻与开发资讯。" }} showPageHeader={false}>
  {latestPost && rendered && Content ? <DailyBrief post={latestPost} headings={rendered.headings} latest><Content components={{ code: Code }} /></DailyBrief> : <div class="empty-state"><h1>第一份简报正在路上</h1><p>内容发布后会在这里展示，你也可以先了解本站。</p><a href="/about">关于日报</a></div>}
  {posts.length > 1 && <section class="recent-editions"><div class="section-heading"><div><p class="eyebrow">THE ARCHIVE</p><h2>回看，发现更多</h2></div><a href="/blog">全部日报 ↗</a></div><PostPreviewList posts={posts.slice(1, 5)} /></section>}
</DefaultPageLayout>
