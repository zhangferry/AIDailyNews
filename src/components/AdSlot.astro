---
// 手动 AdSense 广告位组件（editorial 风格：细线分隔 + 小号衬线标签，与主题一致）
// 用法：<AdSlot slot={AD_SLOT_ARTICLE_BOTTOM} />
// slot 为空时整个组件不渲染
import { ADSENSE_CLIENT } from "../config";

interface Props {
  slot: string;
  label?: string;
}

const { slot, label = "Advertisement" } = Astro.props;
---

{
  slot && (
    <aside class="ad-slot" aria-label="advertisement">
      <span class="ad-label">{label}</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      {/* data-astro-rerun: View Transitions 客户端导航后重新触发广告填充 */}
      <script is:inline data-astro-rerun>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  )
}

<style>
  .ad-slot {
    @apply my-10 py-6 text-center;
    border-top: 1px solid theme("colors.theme.border");
    border-bottom: 1px solid theme("colors.theme.border");
  }

  :global(html.dark) .ad-slot {
    border-top-color: theme("colors.theme.dark-border");
    border-bottom-color: theme("colors.theme.dark-border");
  }

  .ad-label {
    @apply mb-3 block font-display text-[10px] font-medium uppercase tracking-[0.25em] text-theme-text-muted;
  }

  :global(html.dark) .ad-label {
    @apply text-theme-dark-text-muted;
  }
</style>
