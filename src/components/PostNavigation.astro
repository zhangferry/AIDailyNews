---
import type { CollectionEntry } from "astro:content";

interface Props {
  currentPost: {
    data: CollectionEntry<"blog">["data"];
    slug: string;
  };
  previousPost?: CollectionEntry<"blog">;
  nextPost?: CollectionEntry<"blog">;
}

const { currentPost, previousPost, nextPost } = Astro.props;
---

<div class="post-navigation">
  <div class="navigation-buttons">
    {previousPost && (
      <a 
        href={`/blog/${previousPost.slug}`} 
        class="nav-button prev-button"
        title={`较新一期：${previousPost.data.title}`}
      >
        <span aria-hidden="true">←</span>
        <span class="nav-text">{previousPost.data.title}</span>
      </a>
    )}
    
    {nextPost && (
      <a 
        href={`/blog/${nextPost.slug}`} 
        class="nav-button next-button"
        title={`较早一期：${nextPost.data.title}`}
      >
        <span class="nav-text">{nextPost.data.title}</span>
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</div>

<style>
  .post-navigation {
    @apply my-8 py-6 border-t border-theme-border;
  }

  :global(html.dark) .post-navigation {
    @apply border-theme-dark-border;
  }

  .navigation-buttons {
    @apply flex flex-wrap justify-between items-center gap-4;
  }

  .nav-button {
    @apply flex items-center gap-2 px-4 py-2 rounded-lg
           text-theme-primary
           hover:text-theme-secondary
           transition-colors duration-200;
  }

  :global(html.dark) .nav-button {
    @apply text-theme-dark-primary hover:text-theme-dark-secondary;
  }

  .nav-icon {
    @apply w-5 h-5;
  }

  .nav-text {
    @apply font-medium;
  }

  /* 当只有其中一个按钮时的样式 */
  .navigation-buttons:has(.prev-button:only-child) {
    @apply justify-start;
  }

  .navigation-buttons:has(.next-button:only-child) {
    @apply justify-end;
  }
</style>